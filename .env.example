# Copy to .env (never commit the real file). Every provider is optional.
# With zero keys, OpenSDR runs in demo mode using .example fixtures and no network calls.

# --- Providers ---
# Apollo: people + company search, person match, company enrichment.
# Some endpoints require an Apollo *master* API key.
APOLLO_API_KEY=
# Hunter: email finder (waterfall tier 2) and the email verifier.
HUNTER_API_KEY=
# Exa / Tavily: buying signals and account research (either one).
EXA_API_KEY=
TAVILY_API_KEY=
# Instantly API v2: campaign creation and lead enrollment.
INSTANTLY_API_KEY=
# HubSpot private-app token with contacts write scope.
HUBSPOT_ACCESS_TOKEN=

# --- Local settings ---
# Where lists, cache, suppression list and exports live.
OPENSDR_DATA_DIR=
# 1 forces demo mode even when provider keys are present.
OPENSDR_DEMO=0
# 1 disables every tool that writes to an external service.
OPENSDR_READ_ONLY=0
# Hard cap on estimated paid credits per tool call.
OPENSDR_MAX_CREDITS_PER_CALL=25
# How long enrichment results are reused (days).
OPENSDR_CACHE_TTL_DAYS=30
# Which signals provider to use when both keys are set: exa | tavily.
OPENSDR_SIGNALS_PROVIDER=exa
# error | warn | info | debug (logs go to stderr only).
OPENSDR_LOG_LEVEL=info
# Per-request HTTP timeout in milliseconds.
OPENSDR_HTTP_TIMEOUT_MS=20000
